{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrackMesh",
  "version": "0.1.0",
  "identifier": "com.egeozel.trackmesh",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/require-installer-config.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Ege Özel",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "mainBinaryName": "trackmesh-desktop"
}
